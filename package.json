{
  "name": "contextpick",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint src scripts tests/e2e tests/native vite.config.ts playwright.config.ts playwright.native.config.ts playwright.installed.config.ts playwright.native.scale.config.ts eslint.config.js",
    "test": "vitest run && node --test scripts/brand-assets.check.mjs scripts/normalize-bundle-inputs.check.mjs",
    "brand:icons": "node scripts/generate-brand-icons.mjs",
    "brand:preview": "node scripts/preview-brand-icons.mjs",
    "licenses:rust": "node scripts/prepare-rust-notice.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:native": "playwright test --config playwright.native.config.ts",
    "test:native:installed": "playwright test --config playwright.installed.config.ts",
    "test:native:scale": "playwright test --config playwright.native.scale.config.ts"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.13",
    "@tauri-apps/api": "^2.12.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
