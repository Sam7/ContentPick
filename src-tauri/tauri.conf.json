{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ContextPick",
  "version": "0.9.1",
  "identifier": "dev.contextpick.desktop",
  "build": {
    "beforeDevCommand": "corepack pnpm dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "corepack pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "ContextPick", "width": 1200, "height": 800, "minWidth": 720, "minHeight": 520 }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "shortDescription": "Select code. Export AI context.",
    "category": "DeveloperTool",
    "resources": {
      "../LICENSE": "licenses/LICENSE",
      "../licenses/generated/frontend.txt": "licenses/frontend.txt",
      "../licenses/generated/rust.html": "licenses/rust.html",
      "../docs/design/ATTRIBUTION.md": "licenses/ATTRIBUTION.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
